rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────
    //  Helper: Is the requestor authenticated?
    // ─────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // ─────────────────────────────────────────────────
    //  Helper: Does the requestor own this user tree?
    // ─────────────────────────────────────────────────
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────
    //  Users root document — profile & aura code
    // ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // All sub-collections (tasks, inbox, notes, etc.)
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid);

        // Nested sub-collections (e.g. users/{uid}/settings/preferences)
        match /{subCollection}/{subDocId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // ─────────────────────────────────────────────────
    //  Aura codes index (read-only for lookup during sign-in)
    //  users_by_aura_code/{auraCode} → { uid }
    // ─────────────────────────────────────────────────
    match /users_by_aura_code/{auraCode} {
      // Anyone authenticated can look up an aura code (for inviting team members)
      allow read: if isAuth();
      // Only the system (via Admin SDK or the owning user) can write
      allow write: if isAuth() && resource == null; // Only create, no update/delete from client
    }

    // ─────────────────────────────────────────────────
    //  Deny everything else
    // ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
