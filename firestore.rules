rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────
    //  Helper: Is the requestor authenticated?
    // ─────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // ─────────────────────────────────────────────────
    //  Helper: Does the requestor own this user tree?
    // ─────────────────────────────────────────────────
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────
    //  Users root document — profile & aura code
    // ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // All sub-collections (tasks, inbox, notes, etc.)
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid);

        // Nested sub-collections (e.g. users/{uid}/settings/preferences)
        match /{subCollection}/{subDocId} {
          allow read, write: if isOwner(uid);
        }
      }
    }

    // ─────────────────────────────────────────────────
    //  Aura codes index (read-only for lookup during sign-in)
    //  users_by_aura_code/{auraCode} → { uid }
    // ─────────────────────────────────────────────────
    match /aura_uid_index/{auraCode} {
      allow read, write: if isAuth();
    }
    
    // Conversations and messages
    match /conversations/{conversationId} {
      allow read, write: if isAuth();
      
      match /messages/{messageId} {
        allow read, write: if isAuth();
      }
    }

    // ─────────────────────────────────────────────────
    //  Deny everything else
    // ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
