# Aura Backend Server — Environment Variables
# Copy this file to .env and fill in your values before deploying to Render

# ─────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────
PORT=4000

# The URL of THIS server on Render (for the keep-alive self-ping)
# Example: https://aura-backend.onrender.com
RENDER_URL=https://your-app-name.onrender.com

# Comma-separated list of allowed frontend origins (CORS)
# Example: https://aura.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ─────────────────────────────────────────────────────────────────────
# FIREBASE ADMIN SDK
# Go to Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download the JSON file
# Then paste each value below:
# ─────────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=aura-a0d6f
FIREBASE_CLIENT_EMAIL=your-service-account@aura-a0d6f.iam.gserviceaccount.com
# The private key — wrap it in double quotes and keep the \n characters
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────────────
# AI PROVIDERS (optional — users can also set their own keys via Settings)
# These server-level keys act as a fallback / shared pool
# ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
